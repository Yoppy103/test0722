# =============================================================================
# PoC 用の資格情報。このファイルをコピーして .env を作成する。
#   cp .env.example .env
# .env は .gitignore 済み。実データ・本番の資格情報は絶対に入れないこと。
# =============================================================================

# --- スマレジ ---------------------------------------------------------------
# 契約ID（スマレジ管理画面で確認）
SMAREGI_CONTRACT_ID=
# アプリ登録時に払い出される
SMAREGI_CLIENT_ID=
SMAREGI_CLIENT_SECRET=
# sandbox または production
SMAREGI_ENV=sandbox
# 価格を設定する店舗ID
SMAREGI_STORE_ID=1

# --- Bカート -----------------------------------------------------------------
BCART_CLIENT_ID=
BCART_CLIENT_SECRET=
# 認可コードフローで取得済みのトークンを直接使う場合はここに設定する
# （設定されている場合、client_credentials でのトークン取得はスキップされる）
BCART_ACCESS_TOKEN=

# --- 会員ログイン画面の確認用 -------------------------------------------------
# 例: https://xxxxx.bcart.jp
BCART_SHOP_URL=
